# VeriArfy kontrat ortami

# Sepolia RPC (Alchemy / Infura / publicnode)
SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# Deploy eden cuzdanin ozel anahtari (0x'siz de olabilir). ASLA commit'leme.
DEPLOYER_PRIVATE_KEY=""

# Protocol onay dugumlerinin public adresleri (virgulle ayrilir; en az 2).
# Yalnizca public adres yazin: private key, seed veya mnemonic EKLEMEYIN.
# Dugumler ayri kurum/operator ve ayri key-custody/signer ortamlarinda
# tutulmalidir; iki private key'in ayni .env veya proseste olmasi bagimsizlik
# sayilmaz. Deploy otomatik fonlama ya da stake yapmaz.
AUTHORIZED_NODE_ADDRESSES=""

# Live-check her zaman explicit bir asama ile cagrilir:
# prepare | node-1 | node-2 | complete
# LIVE_CHECK_STAGE=prepare

# Prepare icin explicit query type: 1 (GWAS), 2 (ML) veya 4 (STATISTICS).
# Prepare, ilk mutation/FHE proof oncesi zincirde requiredApprovals(type)==2
# degilse fail-closed durur; k-anonimlik esigi dusurulmez.
# LIVE_CHECK_QUERY_TYPE=2

# Prepare ciktisi olan public query/request handoff id'leri.
# LIVE_CHECK_QUERY_ID=42
# LIVE_CHECK_REQUEST_ID=17

# Live-check bu shared .env'i hic yuklemez. NODE_PRIVATE_KEY buraya KONMAZ;
# node-1 ve node-2 ayri operator/key-custody ortamlarinda, ayri process
# shell'lerinde tek tek verilir. Prepare/complete prosesi yalniz
# DEPLOYER_PRIVATE_KEY, node stage'leri yalniz NODE_PRIVATE_KEY kullanir.
# Iki key ayni proseste gorunurse config fail eder.

# Kontrat dogrulamasi icin (opsiyonel)
ETHERSCAN_API_KEY=""

# 1 yapilirsa deploy sirasinda demo bir kimlik agaca eklenir.
SEED_DEMO="0"
