# VeriArfy — ornek ortam degiskenleri.
# Kopyalayin: cp .env.example .env   (.env asla commit edilmez)

# --------------------------------------------------------------------------------------
# SUNUCU TARAFI (packages/curator) — GIZLI
# --------------------------------------------------------------------------------------

# Pinata JWT. Bu deger YALNIZCA sunucuda durur; tarayiciya hicbir zaman inmez.
PINATA_JWT=

# Testte sahte bir Pinata'ya yonlendirmek icin. Bos birakin -> gercek Pinata.
# PINATA_API_URL=https://api.pinata.cloud

# Yukleme siniri ve kaba hiz siniri (IP basina / dakika).
# IPFS_MAX_BYTES=26214400
# IPFS_RATE_LIMIT=10

CURATOR_PORT=8787

# Kurator kokunu zincire yazan cuzdanin anahtari (VeriArfyRegistry sahibi).
# Tanimliysa arastirmaci kaydi otomatik tamamlanir; tanimli degilse kok
# elle yazilmalidir: npm run curator:push-root
# Dagitim anahtarini kullanmayin - yalnizca `updateRoot` yetkisi olan ayri
# bir cuzdan uretip sahipligi ona devredin.
CURATOR_PRIVATE_KEY=

# --------------------------------------------------------------------------------------
# ISTEMCI TARAFI (packages/web) — GIZLI DEGIL
# --------------------------------------------------------------------------------------
#
# DIKKAT: VITE_ ile baslayan her degisken uretilen JS'in icine DUZ METIN olarak
# yazilir. Siteyi acan herkes bunlari okuyabilir. Buraya asla gercek bir sir
# koymayin.

# Yukleme vekilinin adresi (curator servisi).
VITE_STORAGE_API=http://localhost:8787

# IPFS okuma gateway'i.
# VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# --- Yalnizca yerel gelistirme --------------------------------------------------------
# Asagidaki ikisi acilirsa tarayici Pinata'ya DOGRUDAN yukler ve JWT paketin
# icine gomulur. Uretimde KESINLIKLE kullanmayin.
# VITE_PINATA_DIRECT=true
# VITE_PINATA_JWT=

# Yetkili dugum servisi (packages/node-operator).
# Virgulle ayrilmis ozel anahtarlar; yalnizca approveDisclosure/heartbeat
# yetkisi olan cuzdanlar. Dagitim anahtarini KULLANMAYIN.
# Alternatif: NODE_WALLETS ile bir JSON dosya yolu verilebilir (yerel gelistirme).
NODE_PRIVATE_KEYS=
NODE_OPERATOR_PORT=8788

# --- Arastirmaci dogrulamasi (kurator) -------------------------------------
# E-posta ve ORCID ozetlerinin HMAC anahtari ve jeton imzasi. En az 32 karakter.
# DEGISMEMELI: degisirse eski ozetlerle eslesme kaybolur, ayni kisi yeniden
# kaydolabilir. Uretmek icin:
#   node -e 'console.log(require("crypto").randomBytes(48).toString("base64url"))'
CURATOR_IDENTITY_SECRET=
# Kod e-postalari HTTPS API ile gider (barindirma ortami SMTP portlarini engelliyor).
# Resend dogrulanmis bir alan adi ister.
RESEND_API_KEY=
MAIL_FROM="VeriArfy <dogrulama@alan-adiniz.com>"
# ORCID genel API istemcisi (ucretsiz). Yonlendirme adresi:
#   <PUBLIC_CURATOR_URL>/verify/orcid/callback
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# Kuratorun disaridan erisilen adresi (ORCID donusu ve operator onay baglantilari).
PUBLIC_CURATOR_URL=https://veriarfy-curator.onrender.com
# Dogrulama sonrasi donulecek uygulama adresi.
WEB_APP_URL=https://veri-arfy.vercel.app
# YOK Akademik / AVESIS basvurularinin gidecegi operator adresi.
OPERATOR_EMAIL=
