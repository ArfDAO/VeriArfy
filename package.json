{
  "name": "veriarfy",
  "private": true,
  "version": "0.1.0",
  "description": "VeriArfy — FHE tabanli biyoinformatik veri paylasim agi. ZK ile kimlik, FHE ile veri.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/client-side-rust",
    "packages/client-fhe-rust",
    "packages/circuits",
    "packages/study",
    "packages/contracts",
    "packages/curator",
    "packages/web",
    "packages/ml"
  ],
  "scripts": {
    "circuits:build": "npm run build --workspace packages/circuits",
    "contracts:compile": "npm run compile --workspace packages/contracts",
    "contracts:test": "npm run test --workspace packages/contracts",
    "study:verify": "npm run verify --workspace packages/contracts",
    "contracts:deploy:sepolia": "npm run deploy:sepolia --workspace packages/contracts",
    "web:dev": "npm run dev --workspace packages/web",
    "web:build": "npm run build --workspace packages/web",
    "curator": "npm run start --workspace packages/curator",
    "curator:push-root": "npm run push-root --workspace packages/curator",
    "study:test": "npm run test --workspace packages/study",
    "web:prepare": "npm run prepare-circuits --workspace packages/web",
    "ml:setup": "npm run setup --workspace packages/ml",
    "ml:test": "npm run test --workspace packages/ml",
    "ml:poc": "npm run start --workspace packages/ml",
    "ml:server": "npm run server --workspace packages/ml",
    "wasm:build": "npm run build --workspace packages/client-side-rust",
    "wasm:test": "npm run test --workspace packages/client-side-rust",
    "fhe:build": "npm run build --workspace packages/client-fhe-rust",
    "fhe:test": "npm run test --workspace packages/client-fhe-rust",
    "chain:d15-readiness": "npm run d15-readiness:sepolia --workspace packages/contracts",
    "chain:d15-deploy": "npm run deploy:d15:sepolia --workspace packages/contracts",
    "chain:d15-resume": "npm run d15-resume:sepolia --workspace packages/contracts",
    "chain:preflight": "npm run preflight:sepolia --workspace packages/contracts",
    "chain:proof-check": "npm run proof-check:sepolia --workspace packages/contracts",
    "chain:stake-node": "npm run stake-node:sepolia --workspace packages/contracts",
    "chain:live-check": "npm run live-check:sepolia --workspace packages/contracts",
    "storage:e2e": "node scripts/e2e-storage.mjs"
  },
  "devDependencies": {
    "multiformats": "^13.4.2"
  },
  "dependencies": {
    "@ipld/car": "^5.4.7",
    "@nomicfoundation/solidity-analyzer": "^0.1.2",
    "@web3-storage/data-segment": "^5.3.0",
    "@zondax/filecoin-solidity": "^4.0.3",
    "blockstore-core": "^7.0.1",
    "ipfs-unixfs-importer": "^17.0.1"
  }
}
