node_modules/
.DS_Store

# hardhat
artifacts/
cache/
types/
typechain-types/
fhevmTemp/
# Dagitim adresleri: KLASOR degil ICERIK yoksayilir.
#
# `deployments/` yazilirsa git klasore hic inmez ve icindeki tek bir dosyayi
# geri almak IMKANSIZ olur (gitignore kurali: dislanmis bir klasorun altindaki
# dosya yeniden dahil edilemez). `deployments/*` icerigi disler, klasoru degil.
#
# `sepolia.json` izlenmeli: icinde yalnizca ZINCIRDE ZATEN ACIK olan adresler
# var ve `verify-storage-deals` betigi onsuz kosamiyor — CI'da bu is aylarca
# "ENOENT: deployments/sepolia.json" ile kirmizi kaldi.
deployments/*
!packages/contracts/deployments/sepolia.json
coverage/
coverage.json

# circuits — uretilebilir ciktilar (npm run circuits:build)
packages/circuits/build/
packages/circuits/ptau/
packages/circuits/bin/
*.zkey
*.r1cs
*.sym
*.wtns

# web — devre ciktilari build sirasinda kopyalanir (npm run web:prepare)
packages/web/public/circuits/
# Zama SDK wasm — npm run prepare-fhe-wasm ile uretilir
packages/web/public/fhe/

# kurator calisma durumu (katilimci agaci)
packages/curator/data/

# derleme ciktilari
dist/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# env
.env
.env.local
.env*.local
!.env.example

# Python / ML Environments
.venv/
__pycache__/
*.pyc
packages/ml/.venv/
# ML verisi: ICERIK yoksayilir, kripto PARAMETRELERI izlenir.
#
# Klasorde iki farkli sey var:
#   - GIZLI/BUYUK: submissions.json (duz metin anket yanitlari), chrMT.vcf.gz
#   - YAPILANDIRMA: tfhers_params*.json (447 bayt, TFHE-rs parametreleri)
#
# Ikincisi kodun bir parcasi; testler onsuz kosamiyor ve CI'da kopru testi
# "FileNotFoundError: tfhers_params_zama.json" ile kirmizi kaldi.
packages/ml/data/*
!packages/ml/data/tfhers_params*.json
packages/ml/rust_expander/
